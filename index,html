        <h2>Why This Works: Key Factors</h2>

        <ol>
            <li><strong>No Input Validation:</strong> The deserializer trusts the reference path without checking for dangerous properties</li>
            <li><strong>JavaScript Prototype Chain:</strong> All objects inherit from Object.prototype, providing a path to constructors</li>
            <li><strong>Function Constructor:</strong> JavaScript's Function() constructor can execute arbitrary strings as code</li>
            <li><strong>Server-Side Execution:</strong> Code runs with full Node.js privileges, not sandboxed</li>
        </ol>

        <h2>The Patch (Next.js 15.1.4+)</h2>

        <div class="success-highlight">
            <h3>How the Fixed Version Prevents This</h3>
            
            <pre><code>function deserializeServerAction(formData) {
  const values = [/* ... */];
  
  if (values[0].then && values[0].then.startsWith("$")) {
    const parts = values[0].then.split(":");
    
    // ✅ PATCHED: Validate each part of the reference path
    const dangerousProperties = ["__proto__", "constructor", "prototype"];
    
    for (const part of parts) {
      if (dangerousProperties.includes(part)) {
        // Reject the request immediately
        throw new Error("Invalid reference: dangerous property access detected");
      }
    }
    
    // Safe to traverse now
    let target = values[startIndex];
    for (let i = 1; i < parts.length; i++) {
      target = target[parts[i]];
    }
  }
}</code></pre>
